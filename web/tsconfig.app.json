{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // Browser code, bundled by Vite (tsc only checks types, Vite does the build)
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,

    // Same import style as the server: `import ... from "./App.tsx"`
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,

    // `@shared/api-types.ts` points at the server's response types. Only `import type` is used,
    // so the import disappears at build time and no server code reaches the browser.
    "paths": {
      "@shared/*": ["../server/src/shared/*"]
    },

    // Type safety
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
