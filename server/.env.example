# Copy this file to .env and fill in the values.
# In production (Render), set the same names in the service's Environment settings instead.

# Postgres connection (local Docker database from docker-compose.yml)
# In production: the Neon connection string. Change its sslmode=require to sslmode=verify-full:
# the pg driver already treats them the same, and verify-full stops its warning on every start.
DATABASE_URL=postgres://pitwall:pitwall@localhost:5432/pitwall

# API server (Render sets PORT itself)
PORT=3001
# In production: the Vercel address of the web app, e.g. https://pit-wall.vercel.app
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=5

# LLM provider: "groq" (default) or "google"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Where the embedding model files are stored (filled by `npm run model:prefetch`)
MODEL_CACHE_DIR=.model-cache
