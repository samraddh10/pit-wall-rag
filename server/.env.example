# Copy this file to .env and fill in the values.

# Postgres connection (local Docker database from docker-compose.yml)
DATABASE_URL=postgres://pitwall:pitwall@localhost:5432/pitwall

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=5

# LLM provider: "groq" (default) or "google"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Where the embedding model files are stored
MODEL_CACHE_DIR=.model-cache
