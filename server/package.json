{
  "name": "pitwall-server",
  "version": "0.1.0",
  "private": true,
  "description": "Pit Wall API, ingestion and evaluation scripts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx --env-file-if-exists=.env src/scripts/db-check.ts",
    "ingest": "tsx --env-file-if-exists=.env src/scripts/ingest.ts",
    "search": "tsx --env-file-if-exists=.env src/scripts/search.ts",
    "ask": "tsx --env-file-if-exists=.env src/scripts/ask.ts",
    "eval:retrieval": "tsx --env-file-if-exists=.env src/scripts/eval-retrieval.ts",
    "model:prefetch": "tsx --env-file-if-exists=.env src/scripts/prefetch-model.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/groq": "4.0.63",
    "@huggingface/transformers": "4.3.1",
    "ai": "7.0.143",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "pg": "8.23.1",
    "unpdf": "1.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
